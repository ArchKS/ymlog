<% const _booklistColumns = (theme.read_booklist && theme.read_booklist.columns) || null; %>
<% const _booklistWidths = (theme.read_booklist && theme.read_booklist.widths) || null; %>
<% const _booklistAligns = (theme.read_booklist && theme.read_booklist.aligns) || null; %>
<script>
window.BOOKLIST_COLUMNS = <%- JSON.stringify(_booklistColumns) %>;
window.BOOKLIST_WIDTHS = <%- JSON.stringify(_booklistWidths) %>;
window.BOOKLIST_ALIGNS = <%- JSON.stringify(_booklistAligns) %>;
window.BOOKLIST_FILTER_MIN = <%- JSON.stringify((theme.read_booklist && theme.read_booklist.filter_min_count) || 1) %>;
window.STAMP_SRC = <%- JSON.stringify((theme.style && theme.style.stamp) || '/img/stamp.png') %>;
</script>
<%- __js([
    // 'js/utils.js',
    // 'js/header-shrink.js',
    // 'js/back2top.js',
    // 'js/dark-light-toggle.js',
    // 'js/READ.js'
    'js/main.js',
    'js/book-merge.js',
    'js/highlight-table-rows.js',
    'js/invest-table-scale.js',
]) %>

<% if (theme.local_search.enable) { %>
    <%- __js('js/local-search.js') %>
<% } %>

<% if (theme.code_copy.enable) { %>
    <%- __js('js/code-copy.js') %>
<% } %>

<% if (theme.lazyload.enable) { %>
    <%- __js('js/lazyload.js') %>
<% } %>

<div class="post-scripts<%= theme.pjax.enable === true ? ' pjax' : '' %>">
    <% if (theme.toc.enable && is_post()) { %>
        <%- __js([
            'js/libs/anime.min.js',
            // 'js/toc.js',
            // 'js/left-side-toggle.js',
            // 'js/img.js',
            
        ]) %>
    <% } %>
</div>

<% if (theme.pjax.enable === true) { %>
    <%- partial('pjax/pjax') %>
<% } %>
